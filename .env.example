# Hugging Face Configuration
# Get your token from: https://huggingface.co/settings/tokens

# Required for AI-assisted architecture classification
HF_TOKEN=your_hugging_face_token_here

# Optional: Specify a custom zero-shot model
# Default is: MoritzLaurer/deberta-v3-large-zeroshot-v2.0
# Other options: microsoft/deberta-v3-large, facebook/bart-large-mnli
# HF_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v2.0

# Enable AI role classification (refines architecture roles)
# archifind_AI_ASSIST=true

# Enable AI component classification (names architecture blocks intelligently)
# archifind_AI_COMPONENTS=true

# Graph rendering mode: 'architecture' (default) or 'file'
# archifind_GRAPH_MODE=architecture
