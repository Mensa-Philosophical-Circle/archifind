# Archifind environment template
# Copy this file to .env for local usage.
# Never commit .env to git.

# --- Hugging Face credentials (any one token var works) ---
HF_TOKEN=your_hugging_face_token_here
# HUGGING_FACE_HUB_TOKEN=your_hugging_face_token_here
# HUGGINGFACEHUB_API_TOKEN=your_hugging_face_token_here

# --- Models ---
# Zero-shot classification model
# Default: MoritzLaurer/deberta-v3-large-zeroshot-v2.0 (server)
# Fallback path may use: facebook/bart-large-mnli
# HF_MODEL=MoritzLaurer/deberta-v3-large-zeroshot-v2.0

# Chat/reasoning model
# Default: Qwen/Qwen2.5-72B-Instruct
# HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

# --- Client-side proxy settings (recommended for public package users) ---
# Use your private AI proxy so users do not need HF tokens locally.
# ARCHIFIND_AI_PROXY_URL=https://your-proxy.example.com
# ARCHIFIND_AI_PROXY_TOKEN=public_client_token_issued_by_you
# ARCHIFIND_AI_PROXY_TIMEOUT_MS=30000

# --- Archifind feature flags ---
# Include .env files in scanned architecture (off by default)
# ARCHIFIND_INCLUDE_ENV=true

# AI role classification toggle (default true)
# archifind_AI_ASSIST=true

# AI component classification toggle (default true)
# archifind_AI_COMPONENTS=true

# AI-native architecture generation toggle (default true)
# archifind_AI_NATIVE=true

# Graph mode: architecture | file (default architecture)
# archifind_GRAPH_MODE=architecture

# --- Server-side proxy settings (set ONLY on your private proxy server) ---
# Start command: npm run start:ai-proxy
# Keep HF_TOKEN only on the private server, never in the distributed package.

# Comma-separated client tokens allowed to call your proxy
# ARCHIFIND_PROXY_ALLOWED_TOKENS=token-a,token-b

# Abuse protection
# ARCHIFIND_PROXY_RATE_WINDOW_MS=60000
# ARCHIFIND_PROXY_MAX_REQUESTS_PER_WINDOW=30
# ARCHIFIND_PROXY_MAX_DAILY_REQUESTS_PER_TOKEN=2000

# Monitoring/logging
# ARCHIFIND_PROXY_LOG_FILE=./logs/ai-proxy.log
# ARCHIFIND_PROXY_ADMIN_TOKEN=set_a_strong_admin_token
# ARCHIFIND_AI_PROXY_PORT=8787
